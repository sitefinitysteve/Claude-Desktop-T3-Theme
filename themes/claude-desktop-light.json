{
  "name": "Claude Desktop T3 Light",
  "type": "light",
  "colors": {
    "editor.background": "#FAF9F5",
    "editorPane.background": "#FAF9F5",
    "editor.foreground": "#141413",
    "foreground": "#141413",
    "descriptionForeground": "#73726C",
    "disabledForeground": "#73726C",
    "editorWidget.background": "#FFFFFF",
    "dropdown.background": "#FFFFFF",
    "menu.background": "#FFFFFF",
    "quickInput.background": "#FFFFFF",
    "panel.background": "#F5F4ED",
    "panel.border": "#E5E3DA",
    "editorGroup.border": "#E5E3DA",
    "input.background": "#FFFFFF",
    "input.border": "#FFFFFF",
    "input.placeholderForeground": "#9C9A92",
    "focusBorder": "#2F6FD0",
    "button.background": "#2F6FD0",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#285FB3",
    "textLink.foreground": "#2F6FD0",
    "badge.background": "#2F6FD0",
    "activityBarBadge.background": "#2F6FD0",
    "progressBar.background": "#2F6FD0",
    "editorError.foreground": "#B5452F",
    "errorForeground": "#B5452F",
    "editorWarning.foreground": "#A86A1C",
    "list.activeSelectionBackground": "#E8E6DC",
    "list.inactiveSelectionBackground": "#E8E6DC",
    "list.hoverBackground": "#EDEBE3",
    "textCodeBlock.background": "#F5F4ED",
    "editor.findMatchBackground": "#2F6FD0",
    "editor.findMatchForeground": "#FFFFFF",
    "editor.findMatchHighlightBackground": "#F2D6C9",
    "editor.findMatchHighlightForeground": "#141413",
    "editor.selectionBackground": "#F2D6C9",
    "editorCursor.foreground": "#141413",
    "sideBar.background": "#F5F4ED",
    "sideBar.foreground": "#3D3D3A",
    "sideBar.border": "#E8E6DC",
    "activityBar.background": "#F5F4ED",
    "titleBar.activeBackground": "#FAF9F5",
    "titleBar.activeForeground": "#3D3D3A",
    "statusBar.background": "#F5F4ED",
    "tab.activeBackground": "#FAF9F5",
    "tab.inactiveBackground": "#F5F4ED",
    "terminal.background": "#F5F4ED",
    "terminal.foreground": "#3D3D3A",
    "terminalCursor.foreground": "#141413",
    "terminal.selectionBackground": "#F2D6C9",
    "scrollbarSlider.background": "#7F7F7F40"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#9C9A92",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#B5452F"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#4E7A3A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2F6FD0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#A86A1C"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#8A4FA0"
      }
    }
  ]
}